# Бесплатный ключ: https://aistudio.google.com
GEMINI_API_KEY=ваш_ключ_от_gemini_api
DATABASE_PATH=tasks.db
# Запасной часовой пояс (браузер обычно передает свой сам)
DEFAULT_TIMEZONE=UTC

# Необязательные настройки (значения по умолчанию)
MODEL_NAME=gemini-3.6-flash
